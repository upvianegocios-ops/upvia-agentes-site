            {
              "name": "apikey",
              "value": "3gl0eq56t0ahsh3m5lx7ruv8i764qcvd"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.numero, text: $json.texto }) }}",
        "options": {}
      }
    },
    {
      "id": "cad-000f",
      "name": "Responder Entrada Invalida",
      "type": "n8n-nodes-base.respondToWebhook",
