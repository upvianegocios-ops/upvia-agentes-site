        "query": "SELECT whatsapp_numero FROM licitacoes_usuarios WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Extrair Corpo Cadastrar Documento').first().json.usuario_id ] }}"
        }
      }
    },
    {
      "id": "cad-000d",
      "name": "Montar Mensagem Entrada Invalida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "jsCode": "const ctx = $('Extrair Corpo Cadastrar Documento').first().json;\nconst usuario = $input.first().json || {};\nif (!usuario.whatsapp_numero) return [];\nconst texto = 'Nao consegui cadastrar esse documento -- preciso do tipo do documento e de uma data de validade valida. Voce mandou: tipo=\"' + ctx.tipo_documento + '\", data=\"' + ctx.data_validade_bruta + '\".';\nreturn [{ json: { numero: usuario.whatsapp_numero.replace(/\\D/g, ''), texto } }];"
      }
    },
    {
      "id": "cad-000e",
