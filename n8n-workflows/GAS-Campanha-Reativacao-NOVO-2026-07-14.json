        "url": "=https://evo.upviaagentes.com/message/sendText/{{ $json.instancia }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "3gl0eq56t0ahsh3m5lx7ruv8i764qcvd"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.remote_jid, text: $json.mensagem }) }}",
        "options": {}
      }
