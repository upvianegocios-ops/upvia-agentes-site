    {
      "id": "cr-corte-01",
      "name": "Calcular Data Corte Reativacao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        200
      ],
      "parameters": {
        "jsCode": "const loja = $json;\nconst intervaloDias = loja.intervalo_reativacao_dias ?? 30;\nconst cutoff = new Date(Date.now() - intervaloDias * 24 * 3600 * 1000);\n\nreturn [{ json: { ...loja, cutoffISO: cutoff.toISOString() } }];"
      }
    },
    {
      "id": "cr-candidatos-01",
      "name": "Buscar Clientes Candidatos Reativacao",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://clcyyogtvygpehgcmeyj.supabase.co/rest/v1/dados_clientes_gas?negocio_id=eq.{{ $json.id }}&data_ultima_compra=lte.{{ $json.cutoffISO }}&data_ultima_compra=not.is.null&select=id,remote_jid,nome,data_ultima_compra,ultima_reativacao_enviada",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNsY3l5b2d0dnlncGVoZ2NtZXlqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDA4NTQ3NCwiZXhwIjoyMDk1NjYxNDc0fQ.XizutisZ4syhlUMlTRisVg1J8jFNNrZ9bF54ntF4B4M"
            },
            {
              "name": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNsY3l5b2d0dnlncGVoZ2NtZXlqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MDA4NTQ3NCwiZXhwIjoyMDk1NjYxNDc0fQ.XizutisZ4syhlUMlTRisVg1J8jFNNrZ9bF54ntF4B4M"
            }
