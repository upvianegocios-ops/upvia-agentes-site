    {
      "id": "cr-filtrar-01",
      "name": "Filtrar Nao Contatados Reativacao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ],
      "parameters": {
        "jsCode": "const loja = $('Calcular Data Corte Reativacao').first().json;\nconst candidatos = $input.all().map(i => i.json);\n\n// So elegivel se nunca recebeu reativacao desde a ultima compra dele -\n// garante 1 envio por periodo de inatividade, reseta quando ele compra de novo.\nconst elegiveis = candidatos.filter(c => {\n  if (!c.data_ultima_compra) return false;\n  if (!c.ultima_reativacao_enviada) return true;\n  return new Date(c.ultima_reativacao_enviada) < new Date(c.data_ultima_compra);\n});\n\nreturn elegiveis.map(c => ({\n  json: {\n    cliente_id: c.id,\n    remote_jid: c.remote_jid,\n    cliente_nome: c.nome || 'cliente',\n    negocio_id: loja.id,\n    negocio_nome: loja.nome,\n    nome_atendente: loja.nome_atendente,\n    instancia: loja.instancia_whatsapp,\n  }\n}));"
      }
    },
    {
      "id": "cr-loop-cliente-01",
      "name": "Loop Clientes Reativacao",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1520,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "cr-montar-msg-01",
      "name": "Montar Mensagem Reativacao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        100
      ],
      "parameters": {
        "jsCode": "const d = $json;\nconst nome = d.cliente_nome || 'cliente';\nconst nomeAtendente = d.nome_atendente || 'nossa atendente';\nconst negocioNome = d.negocio_nome || 'nossa loja';\n\nconst variantes = [\n  `Oi ${nome}! Faz uns dias que voce nao pede gas com a gente, ja ta precisando de reposicao? Qualquer coisa, estamos aqui! - ${nomeAtendente}, da ${negocioNome}`,\n  `Opa ${nome}, tudo bem? Notei que faz um tempinho que voce nao faz pedido aqui na ${negocioNome}. Se precisar de gas ou agua, e so chamar! - ${nomeAtendente}`,\n  `${nome}, sentimos sua falta por aqui! Se estiver precisando de gas, e so me chamar que eu resolvo rapidinho. - ${nomeAtendente}, ${negocioNome}`,\n  `Oi ${nome}! Passando pra saber se ja ta na hora de repor o gas ai em casa. Qualquer coisa e so mandar mensagem! - ${nomeAtendente}`,\n  `Oi ${nome}, tudo certo? Faz um tempo que voce nao pede com a gente na ${negocioNome} - se precisar, e so chamar!`,\n];\nconst mensagem = variantes[Math.floor(Math.random() * variantes.length)];\n\nreturn [{ json: { ...d, mensagem } }];"
      }
    },
    {
      "id": "cr-enviar-01",
      "name": "Enviar Mensagem Reativacao WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1960,
        100
      ],
      "onError": "continueRegularOutput",
