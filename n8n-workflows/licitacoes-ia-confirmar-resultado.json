      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT whatsapp_numero FROM licitacoes_usuarios WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Extrair Corpo Confirmar Resultado').first().json.usuario_id ] }}"
        }
      }
    },
    {
      "id": "cnf-0007",
      "name": "Confirmacao Valida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cnf-0008",
              "leftValue": "={{ !!$('Extrair Corpo Confirmar Resultado').first().json.resultado && ['aguardando_resultado','proposta_readequada'].includes($('Buscar Resumo Confirmar').first().json.fase_atual) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cnf-0009",
      "name": "Atualizar Fase Confirmada",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        -140
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE licitacoes_resumos SET resultado = $2, fase_atual = $2 WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Extrair Corpo Confirmar Resultado').first().json.resumo_id, $('Extrair Corpo Confirmar Resultado').first().json.resultado ] }}"
        }
      }
    },
    {
      "id": "cnf-000a",
      "name": "Atualizar Valor Proposta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        -140
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE licitacoes_propostas SET valor_ofertado = $2\nWHERE resumo_id = $1 AND valor_ofertado IS NULL\n  AND id = (SELECT id FROM licitacoes_propostas WHERE resumo_id = $1 ORDER BY criado_em DESC LIMIT 1);",
        "options": {
          "queryReplacement": "={{ [ $('Extrair Corpo Confirmar Resultado').first().json.resumo_id, $('Extrair Corpo Confirmar Resultado').first().json.valor_final ] }}"
        }
      }
    },
    {
      "id": "cnf-000b",
      "name": "Montar Mensagem Confirmacao Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -140
      ],
      "parameters": {
        "jsCode": "const ctx = $('Extrair Corpo Confirmar Resultado').first().json;\nconst resumo = $('Buscar Resumo Confirmar').first().json;\nconst usuario = $('Buscar Usuario Confirmar').first().json || {};\nif (!usuario.whatsapp_numero) return [];\nlet texto;\nif (ctx.resultado === 'vencida') {\n  texto = '🎉 Show! Registrei que voce venceu \"' + (resumo.objeto_resumo || resumo.resumo_id) + '\"' +\n    (ctx.valor_final != null ? (' pelo valor de R$ ' + ctx.valor_final.toLocaleString('pt-BR', { minimumFractionDigits: 2 })) : '') +\n    '. Ja vou preparar um rascunho de contrato pra voce revisar.';\n} else {\n  texto = 'Registrado: \"' + (resumo.objeto_resumo || resumo.resumo_id) + '\" nao foi vencida dessa vez. Obrigado por avisar!';\n}\nreturn [{ json: { numero: usuario.whatsapp_numero.replace(/\\D/g, ''), texto } }];"
      }
    },
    {
      "id": "cnf-000c",
      "name": "Enviar Confirmacao Resultado WhatsApp",
