    {
      "id": "cnf-000h",
      "name": "Montar Mensagem Confirmacao Invalida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        220
      ],
      "parameters": {
        "jsCode": "const ctx = $('Extrair Corpo Confirmar Resultado').first().json;\nconst resumo = $('Buscar Resumo Confirmar').first().json;\nconst usuario = $('Buscar Usuario Confirmar').first().json || {};\nif (!usuario.whatsapp_numero) return [];\nlet texto;\nif (!ctx.resultado) {\n  texto = 'Nao entendi se voce venceu ou perdeu essa licitacao -- me diz claramente \"ganhei\" ou \"perdi\".';\n} else {\n  texto = 'Nao consigo confirmar esse resultado agora: a licitacao esta na fase \"' + resumo.fase_atual + '\", e so aceito confirmacao de vitoria/derrota depois que uma proposta ja foi gerada (fase \"aguardando_resultado\" ou \"proposta_readequada\").';\n}\nreturn [{ json: { numero: usuario.whatsapp_numero.replace(/\\D/g, ''), texto } }];"
      }
