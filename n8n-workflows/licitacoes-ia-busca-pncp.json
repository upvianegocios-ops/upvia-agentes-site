    {
      "id": "pncp-0009",
      "name": "Buscar Pagina 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        160
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao?dataInicial=' + $json.dataInicial + '&dataFinal=' + $json.dataFinal + '&codigoModalidadeContratacao=' + $json.modalidade_codigo + '&pagina=1&tamanhoPagina=50' }}",
        "options": {}
      }
    },
    {
      "id": "pncp-000a",
      "name": "Calcular Paginacao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        160
      ],
      "parameters": {
        "jsCode": "const consulta = $('Loop Consultas').first().json;\nconst resp = $input.first().json;\nconst registrosPagina1 = (resp && resp.data) || [];\nconst totalPaginas = (resp && resp.totalPaginas) || 1;\nconst paginasFaltando = [];\nfor (let p = 2; p <= Math.min(totalPaginas, 150); p++) paginasFaltando.push(p);\nreturn [{ json: { consulta, registrosPagina1, paginasFaltando, totalPaginas } }];"
      }
    },
    {
      "id": "pncp-000b",
      "name": "Tem Mais Paginas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
