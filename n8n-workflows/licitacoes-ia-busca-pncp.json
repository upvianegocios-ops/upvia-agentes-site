        "url": "={{ 'https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao?dataInicial=' + $('Calcular Paginacao').first().json.consulta.dataInicial + '&dataFinal=' + $('Calcular Paginacao').first().json.consulta.dataFinal + '&codigoModalidadeContratacao=' + $('Calcular Paginacao').first().json.consulta.modalidade_codigo + '&pagina=' + $json.pagina + '&tamanhoPagina=50' }}",
        "options": {}
