        "options": {}
      }
    },
    {
      "id": "pncp-0005",
      "name": "Fim Busca PNCP",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        -160
      ],
      "parameters": {}
    },
    {
      "id": "pncp-0006",
      "name": "Montar Consultas Modalidade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "jsCode": "const perfil = $input.first().json;\nconst MODALIDADES = { pregao_eletronico: 6, dispensa: 8 };\n\nconst hoje = new Date();\nconst ontem = new Date(hoje.getTime() - 24 * 60 * 60 * 1000);\nconst fmt = (d) => d.toISOString().slice(0, 10).replace(/-/g, '');\n\nconst modalidades = Array.isArray(perfil.modalidades) ? perfil.modalidades : [];\nconst out = [];\nfor (const m of modalidades) {\n  const codigo = MODALIDADES[m];\n  if (!codigo) continue;\n  out.push({ json: {\n    perfil_id: perfil.perfil_id,\n    nome_perfil: perfil.nome_perfil,\n    whatsapp_numero: perfil.whatsapp_numero,\n    palavras: perfil.objeto_palavras_chave || [],\n    valor_min: perfil.valor_min,\n    valor_max: perfil.valor_max,\n    uf: perfil.uf || [],\n    municipio: perfil.municipio || [],\n    tipo_perfil: perfil.tipo_perfil,\n    modalidade_codigo: codigo,\n    dataInicial: fmt(ontem),\n    dataFinal: fmt(hoje)\n  } });\n}\nreturn out;"
      }
    },
    {
      "id": "pncp-0007",
