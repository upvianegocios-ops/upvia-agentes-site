      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      }
    },
    {
      "id": "pncp-0003",
      "name": "Buscar Perfis Ativos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.id AS perfil_id, p.nome_perfil, p.objeto_palavras_chave, p.modalidades,\n       p.valor_min, p.valor_max, p.uf, p.municipio, p.tipo_perfil, u.whatsapp_numero\nFROM licitacoes_perfis_busca p\nJOIN licitacoes_usuarios u ON u.id = p.usuario_id\nWHERE p.ativo = true AND u.ativo = true;",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
      }
    },
    {
      "id": "pncp-0004",
      "name": "Loop Perfis",
      "type": "n8n-nodes-base.splitInBatches",
