    {
      "id": "pncp-000p",
      "name": "Filtrar Duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        160
      ],
      "parameters": {
        "jsCode": "const candidatos = $('Expandir Resultados Filtrados').all().map(i => i.json);\nconst jaEnviados = new Set($input.all().map(i => i.json && i.json.pncp_id).filter(Boolean));\nconst novos = candidatos.filter(c => !jaEnviados.has(c.pncp_id));\nreturn [{ json: { novos } }];"
