    {
      "id": "pncp-000t",
      "name": "Montar Mensagem Edital",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "// BUG REAL DE PRODUCAO (confirmado 14/08: perfil do Jonas achou 6 editais novos\n// no mesmo ciclo, mas so 1 mensagem foi enviada): esse node usava $input.first(),\n// que pega so o PRIMEIRO item recebido e descarta o resto silenciosamente. Como\n// \"Enviar Edital WhatsApp\" e \"Registrar Envio\" (nodes nao-Code) rodam automaticamente\n// uma vez por item de entrada, bastava esse Code node devolver 1 item so pra travar\n// o ciclo inteiro em \"no maximo 1 notificacao por perfil a cada 3h\", nao importa\n// quantas licitacoes novas realmente existissem. Corrigido pra processar TODOS os\n// itens recebidos (uma mensagem por licitacao nova).\nfunction formataValor(v) {\n  if (v == null) return 'valor nao informado';\n  return 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2 });\n}\nreturn $input.all().map(({ json: item }) => {\n  const texto = 'Nova licitacao para o alerta \"' + item.nome_perfil + '\":\\n\\n' +\n    item.objeto.slice(0, 300) + (item.objeto.length > 300 ? '...' : '') + '\\n\\n' +\n    'Orgao: ' + item.orgao + '\\n' +\n    'Valor estimado: ' + formataValor(item.valor) + '\\n' +\n    'Modalidade: ' + item.modalidade_nome + '\\n' +\n    (item.municipio ? ('Local: ' + item.municipio + '/' + item.uf + '\\n') : '') +\n    '\\nEdital: ' + item.link;\n  return { json: { ...item, numero: item.whatsapp_numero.replace(/\\D/g, ''), texto } };\n});"
      }
    },
