    },
    {
      "id": "pncp-000h",
      "name": "Combinar Com Extras",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        260
      ],
      "parameters": {
        "jsCode": "const base = $('Calcular Paginacao').first().json;\nconst extras = $input.all().map(i => (i.json && i.json.data) || []).flat();\nreturn [{ json: { ...base.consulta, data: base.registrosPagina1.concat(extras) } }];"
      }
    },
    {
      "id": "pncp-000i",
      "name": "Fim Iteracao Consulta",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2420,
        160
      ],
      "parameters": {}
    },
    {
      "id": "pncp-000j",
      "name": "Extrair e Filtrar Editais",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "jsCode": "function normalizar(s) {\n  return String(s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\n\nconst combinados = $input.all();\nconst resultados = [];\n\nfor (const item of combinados) {\n  const consulta = item.json;\n  const registros = consulta.data || [];\n  const palavrasNorm = (consulta.palavras || []).map(normalizar).filter(Boolean);\n  const ufsPerfil = consulta.uf || [];\n  const municipiosNorm = (consulta.municipio || []).map(normalizar).filter(Boolean);\n\n  for (const r of registros) {\n    const objetoNorm = normalizar(r.objetoCompra);\n    const bateuPalavra = palavrasNorm.some(p => objetoNorm.includes(p));\n    if (!bateuPalavra) continue;\n\n    const valor = r.valorTotalEstimado != null ? Number(r.valorTotalEstimado) : null;\n    if (consulta.valor_min != null && (valor == null || valor < consulta.valor_min)) continue;\n    if (consulta.valor_max != null && (valor == null || valor > consulta.valor_max)) continue;\n\n    const uf = r.unidadeOrgao ? r.unidadeOrgao.ufSigla : null;\n    if (ufsPerfil.length && !ufsPerfil.includes(uf)) continue;\n\n    const municipio = r.unidadeOrgao ? r.unidadeOrgao.municipioNome : null;\n    if (municipiosNorm.length && !municipiosNorm.includes(normalizar(municipio))) continue;\n\n    const cnpj = (r.orgaoEntidade && r.orgaoEntidade.cnpj) || (r.orgaoSubRogado && r.orgaoSubRogado.cnpj) || '';\n    const link = 'https://pncp.gov.br/app/editais/' + cnpj + '/' + r.anoCompra + '/' + r.sequencialCompra;\n\n    resultados.push({\n      perfil_id: consulta.perfil_id,\n      nome_perfil: consulta.nome_perfil,\n      whatsapp_numero: consulta.whatsapp_numero,\n      pncp_id: r.numeroControlePNCP,\n      objeto: r.objetoCompra,\n      orgao: (r.orgaoEntidade && r.orgaoEntidade.razaoSocial) || '',\n      valor,\n      uf,\n      municipio,\n      modalidade_nome: r.modalidadeNome,\n      link,\n      data_abertura_proposta: r.dataAberturaProposta || null,\n      data_encerramento_proposta: r.dataEncerramentoProposta || null,\n      tipo_perfil: consulta.tipo_perfil\n    });\n  }\n}\n// envelope (1 item sempre) -- ver nota abaixo sobre o gotcha de 0 itens matando o loop\nreturn [{ json: { resultados } }];"
      }
    },
