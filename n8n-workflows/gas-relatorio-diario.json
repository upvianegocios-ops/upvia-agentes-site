    {
      "id": "gas-node-006",
      "name": "Montar Relatorio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const loja = $('Para Cada Loja').first().json;\nconst pedidos = $('Buscar Pedidos de Ontem').all().map(i => i.json);\nconst entregadores = $('Buscar Entregadores da Loja').all().map(i => i.json);\n\nconst hoje = new Date();\nconst ontem = new Date(hoje);\nontem.setDate(ontem.getDate() - 1);\nconst dataFormatada = ontem.toLocaleDateString('pt-BR');\n\nif (!pedidos || pedidos.length === 0) {\n  return [{\n    json: {\n      telefone_admin: loja.telefone_admin,\n      instancia: loja.instancia_whatsapp,\n      nome_loja: loja.nome,\n      mensagem: `📊 *Relatorio ${loja.nome} - ${dataFormatada}*\\n\\nNenhum pedido registrado ontem.`\n    }\n  }];\n}\n\nconst porProduto = {};\npedidos.forEach(p => {\n  const prod = p.produto_nome ?? 'Nao informado';\n  porProduto[prod] = (porProduto[prod] ?? 0) + 1;\n});\n\nconst porEntregador = {};\npedidos.forEach(p => {\n  if (p.entregador_id) {\n    const ent = entregadores.find(e => e.id === p.entregador_id);\n    const nome = ent?.nome ?? 'Entregador ' + p.entregador_id;\n    porEntregador[nome] = (porEntregador[nome] ?? 0) + 1;\n  }\n});\n\nconst despachados = pedidos.filter(p => p.status === 'despachado').length;\nconst entregues = pedidos.filter(p => p.status === 'entregue').length;\nconst cancelados = pedidos.filter(p => p.status === 'cancelado').length;\n\nconst faturamento = pedidos.reduce((acc, p) => acc + (parseFloat(p.valor_total) || 0), 0);\n\nconst produtosTexto = Object.entries(porProduto)\n  .map(([nome, qtd]) => `   • ${nome}: ${qtd} pedido${qtd > 1 ? 's' : ''}`)\n  .join('\\n');\n\nconst entregadoresTexto = Object.entries(porEntregador)\n  .map(([nome, qtd]) => `   • ${nome}: ${qtd} entrega${qtd > 1 ? 's' : ''}`)\n  .join('\\n');\n\nconst mensagem = `📊 *Relatorio ${loja.nome}*\n📅 ${dataFormatada}\n\n*Total de pedidos: ${pedidos.length}*\n\n📦 *Por produto:*\n${produtosTexto}\n\n🛵 *Por entregador:*\n${entregadoresTexto || '   • Nao informado'}\n\n📋 *Status:*\n   • Despachados: ${despachados}\n   • Entregues: ${entregues}\n   • Cancelados: ${cancelados}\n\n💰 *Faturamento estimado: R$${faturamento.toFixed(2)}*\n\n_Relatorio gerado automaticamente pela UpGasIA_ 🤖`;\n\nreturn [{\n  json: {\n    telefone_admin: loja.telefone_admin,\n    instancia: loja.instancia_whatsapp,\n    nome_loja: loja.nome,\n    mensagem\n  }\n}];"
      }
