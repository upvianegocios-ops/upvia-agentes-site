        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "fav-0007",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
