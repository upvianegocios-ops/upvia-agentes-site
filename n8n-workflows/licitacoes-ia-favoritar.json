      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        -160
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT whatsapp_numero FROM licitacoes_usuarios WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $('Extrair Corpo Favoritar').first().json.usuario_id ] }}"
        }
      }
    },
    {
      "id": "fav-000a",
      "name": "Montar Mensagem Favoritar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ],
      "parameters": {
        "jsCode": "const resultado = $('Alternar Favorito').first().json;\nconst usuario = $input.first().json || {};\nif (!usuario.whatsapp_numero) return [];\nconst texto = resultado.favorito\n  ? '⭐ Favoritada: \"' + (resultado.objeto_resumo || resultado.id) + '\"'\n  : 'Removida dos favoritos: \"' + (resultado.objeto_resumo || resultado.id) + '\"';\nreturn [{ json: { numero: usuario.whatsapp_numero.replace(/\\D/g, ''), texto } }];"
      }
    },
    {
      "id": "fav-000b",
      "name": "Enviar Favoritar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
