{
  "name": "Licitacoes IA - Agente Redator de Propostas",
  "nodes": [
    {
      "id": "red-0001",
      "name": "Nota Agente Redator",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ],
      "parameters": {
        "content": "## Agente Redator de Propostas\nSub-workflow reutilizavel via webhook: POST /webhook/licitacoes/agente-redator\nBody: { resumo_id, perfil_id?, usuario_id? }\n\nChamado automaticamente pelo Agente Resumidor (sempre, apos gravar um resumo) e\nsob demanda pelo Orquestrador Central (tool_redigir_proposta).\n\nREGRA FIXA: o valor da proposta NUNCA e decidido pela IA -- sempre fica marcado\ncomo [VALOR A DEFINIR PELO USUARIO]. O rascunho e sempre enviado como rascunho\npra revisao humana, nunca enviado/submetido em nenhuma plataforma.",
        "width": 900,
        "height": 220,
        "color": 4
      }
    },
    {
      "id": "red-0002",
      "name": "Webhook Redator",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "red-0003",
      "parameters": {
        "httpMethod": "POST",
        "path": "licitacoes/agente-redator",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "red-0004",
      "name": "Extrair Corpo Redator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nreturn [{ json: { resumo_id: body.resumo_id || null, perfil_id: body.perfil_id || null, usuario_id: body.usuario_id || null } }];"
      }
    },
    {
      "id": "red-0005",
      "name": "Buscar Resumo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, perfil_id, pncp_id, objeto_resumo, tipo_disputa, valor_estimado, prazo_proposta, prazo_entrega, documentos_exigidos, fase_atual FROM licitacoes_resumos WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.resumo_id ] }}"
        }
      }
    },
    {
      "id": "red-0006",
      "name": "Fase Permite Proposta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "red-0007",
              "leftValue": "={{ ['analisada','aguardando_resultado'].includes($json.fase_atual) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "red-0008",
      "name": "Buscar Usuario",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        700,
        -140
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id AS usuario_id, u.whatsapp_numero\nFROM licitacoes_usuarios u\nWHERE u.id = $1\n   OR u.id = (SELECT usuario_id FROM licitacoes_perfis_busca WHERE id = $2)\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $('Extrair Corpo Redator').first().json.usuario_id, $('Extrair Corpo Redator').first().json.perfil_id ] }}"
        }
      }
    },
    {
      "id": "red-0009",
      "name": "Buscar Dados Empresa",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
