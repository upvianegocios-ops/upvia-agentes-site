      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ],
      "parameters": {
        "jsCode": "const resumo = $('Buscar Resumo').first().json;\nconst usuario = $input.first().json || {};\nif (!usuario.whatsapp_numero) return [];\nconst explicacoes = {\n  identificada: 'essa licitacao ainda nao foi totalmente analisada',\n  vencida: 'essa licitacao ja foi marcada como vencida -- se quiser, posso gerar o contrato em vez da proposta',\n  perdida: 'essa licitacao ja foi marcada como perdida, nao faz sentido gerar proposta agora',\n  proposta_readequada: 'essa licitacao ja esta em readequacao de proposta',\n  contrato_gerado: 'essa licitacao ja tem contrato gerado -- o processo de proposta ja foi concluido'\n};\nconst motivo = explicacoes[resumo.fase_atual] || ('a licitacao esta na fase \"' + resumo.fase_atual + '\"');\nconst texto = 'Nao consegui gerar a proposta agora: ' + motivo + '.';\nreturn [{ json: { numero: usuario.whatsapp_numero.replace(/\\D/g, ''), texto } }];"
      }
    },
