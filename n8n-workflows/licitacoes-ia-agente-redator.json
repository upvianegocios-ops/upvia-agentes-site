    {
      "id": "red-000a",
      "name": "Montar Contexto Proposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Buscar Dados Empresa pode devolver 0 linhas (empresa ainda nao cadastrada -- e o\n// caso hoje pro Jonas e pra UpVia) -- trata com placeholders claros, nunca inventa dado.\nconst empresa = $input.first().json || {};\nconst resumo = $('Buscar Resumo').first().json;\nconst usuario = $('Buscar Usuario').first().json;\nreturn [{ json: {\n  resumo_id: resumo.id,\n  usuario_id: usuario.usuario_id || null,\n  razao_social: empresa.razao_social || '[RAZAO SOCIAL A PREENCHER]',\n  cnpj: empresa.cnpj || '[CNPJ A PREENCHER]',\n  endereco: empresa.endereco || '[ENDERECO A PREENCHER]',\n  responsavel_legal: empresa.responsavel_legal || '[RESPONSAVEL LEGAL A PREENCHER]',\n  objeto_resumo: resumo.objeto_resumo,\n  tipo_disputa: resumo.tipo_disputa,\n  prazo_entrega: resumo.prazo_entrega,\n  documentos_exigidos: resumo.documentos_exigidos,\n  whatsapp_numero: usuario.whatsapp_numero\n} }];"
      }
    },
    {
      "id": "red-000b",
      "name": "Redigir Rascunho Proposta",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        1320,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Voce e especialista em licitacoes publicas brasileiras (Lei 14.133/2021). Redija um\nRASCUNHO de proposta comercial pra participar dessa licitacao, em portugues do Brasil,\nformal e objetivo.\n\nA proposta deve conter, nessa ordem:\n1. Dados da empresa proponente (razao social, CNPJ, endereco, responsavel legal)\n2. Descricao do objeto ofertado (baseado no resumo da licitacao)\n3. Prazo de entrega/execucao proposto\n4. Prazo de validade da proposta: 60 dias, salvo se os documentos indicarem prazo\n   diferente (nesse caso, use o prazo indicado)\n5. Declaracoes padrao: ciencia e concordancia com os termos do edital, inexistencia de\n   fatos impeditivos para contratar com a administracao publica, cumprimento das normas\n   de saude e seguranca do trabalho\n\nREGRA ABSOLUTA E INEGOCIAVEL: o valor da proposta NUNCA e decidido por voce. Em todo\nlugar que o valor apareceria, escreva literalmente o texto \"[VALOR A DEFINIR PELO USUARIO]\"\n-- nunca um numero, nunca uma estimativa, nunca um calculo.\n\nResponda so com o texto da proposta, pronto pra revisao humana, sem comentarios extras."
            },
            {
              "role": "user",
              "content": "={{ 'Empresa: ' + $json.razao_social + ' | CNPJ: ' + $json.cnpj + ' | Endereco: ' + $json.endereco + ' | Responsavel: ' + $json.responsavel_legal + '\\n\\nObjeto da licitacao: ' + $json.objeto_resumo + '\\nModalidade: ' + $json.tipo_disputa + '\\nPrazo de entrega esperado: ' + ($json.prazo_entrega || 'nao especificado no edital') + '\\nDocumentos de habilitacao exigidos (contexto, nao repetir na proposta): ' + ($json.documentos_exigidos || 'nao especificado') }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "sjemA3sd4BGEaIHJ",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "red-000c",
      "name": "Extrair Texto Proposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json;\nconst texto = (aiOutput.message && aiOutput.message.content) || '';\nconst ctx = $('Montar Contexto Proposta').first().json;\nreturn [{ json: { ...ctx, conteudo_proposta: texto } }];"
      }
    },
