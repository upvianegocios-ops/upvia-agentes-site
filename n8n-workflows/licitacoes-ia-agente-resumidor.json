      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO licitacoes_resumos\n  (perfil_id, pncp_id, objeto_resumo, tipo_disputa, valor_estimado, prazo_proposta, prazo_entrega, documentos_exigidos, tipo_software)\nVALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)\nON CONFLICT (perfil_id, pncp_id) DO NOTHING\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.perfil_id, $json.pncp_id, $json.objeto_resumo, $json.tipo_disputa, $json.valor_estimado, $json.prazo_proposta, $json.prazo_entrega, $json.documentos_exigidos, $json.tipo_software ] }}"
        }
