      "typeVersion": 2,
      "position": [
        1760,
        60
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{ json: { texto: item.text || '' } }];"
      }
    },
    {
      "id": "res-000e",
      "name": "Marcar Arquivo Ausente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "jsCode": "return [{ json: { texto: '' } }];"
      }
    },
    {
      "id": "res-000f",
      "name": "Fim Iteracao Arquivo",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1980,
        160
