    {
      "id": "res-000g",
      "name": "Combinar Textos Extraidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        380
      ],
      "parameters": {
        "jsCode": "const TETO_CHARS = 15000;\nconst textos = $input.all().map(i => i.json.texto || '').filter(Boolean);\nlet combinado = textos.join('\\n\\n---\\n\\n');\nif (combinado.length > TETO_CHARS) combinado = combinado.slice(0, TETO_CHARS) + '\\n\\n[...texto truncado...]';\nreturn [{ json: { texto_documentos: combinado, teve_documento: textos.length > 0 } }];"
      }
    },
    {
      "id": "res-000h",
      "name": "Gerar Resumo Estruturado",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [
        1320,
        380
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Voce e especialista em licitacoes publicas brasileiras (Lei 14.133/2021). A partir do\ntexto de documentos de um edital (Termo de Referencia/Aviso, quando disponivel) e dos\ndados basicos da licitacao, gere um resumo estruturado.\n\nResponda SOMENTE com um objeto JSON valido, sem markdown, com exatamente estes campos:\n{\n  \"objeto_resumo\": \"resumo curto e claro do que esta sendo comprado/contratado\",\n  \"tipo_disputa\": \"pregao_eletronico\" ou \"dispensa\" (baseado na modalidade informada),\n  \"valor_estimado\": numero ou null,\n  \"prazo_proposta\": \"data/hora em formato ISO se identificavel no texto, senao null\",\n  \"prazo_entrega\": \"texto livre descrevendo o prazo de entrega/execucao, ou null\",\n  \"documentos_exigidos\": \"resumo em linguagem natural dos documentos de habilitacao exigidos (certidoes, atestados, etc) -- se o texto do edital nao tiver detalhe suficiente, baseie-se no que costuma ser exigido nessa modalidade e deixe isso claro no texto\",\n  \"tipo_software\": \"se o objeto for de software/sistema/plataforma, descreva brevemente que tipo de software e; senao, null\"\n}\n\nSe o texto de documentos estiver vazio (nao foi possivel baixar o edital), preencha o\nque der pra inferir dos dados basicos e deixe os campos sem informacao suficiente como null,\nsem inventar dados."
            },
            {
              "role": "user",
              "content": "={{ 'Objeto (dado basico): ' + $('Extrair Corpo Resumidor').first().json.objeto + '\\nOrgao: ' + $('Extrair Corpo Resumidor').first().json.orgao + '\\nModalidade: ' + $('Extrair Corpo Resumidor').first().json.modalidade_nome + '\\nValor estimado (dado basico): ' + $('Extrair Corpo Resumidor').first().json.valor + '\\n\\nTexto extraido dos documentos do edital:\\n' + ($json.texto_documentos || '(nenhum documento conseguiu ser baixado)') }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "sjemA3sd4BGEaIHJ",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "res-000i",
      "name": "Parse Resumo IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        380
      ],
      "parameters": {
        "jsCode": "// Code node roda em \"Run Once for All Items\" por padrao -- $json nao existe nesse\n// modo (ver gotcha ja documentado no Prospeccao/Licitacoes). Usar $input.first().json.\nconst aiOutput = $input.first().json;\nconst raw = (aiOutput.message && aiOutput.message.content) || '';\nlet parsed = null;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : null;\n} catch (e) {\n  parsed = null;\n}\nconst base = $('Extrair Corpo Resumidor').first().json;\nif (!parsed) {\n  // fallback defensivo -- nunca quebra o fluxo por causa de JSON malformado da IA\n  parsed = { objeto_resumo: base.objeto, tipo_disputa: null, valor_estimado: base.valor,\n    prazo_proposta: null, prazo_entrega: null, documentos_exigidos: null, tipo_software: null };\n}\nconst tipoDisputa = base.modalidade_nome && /preg[aã]o/i.test(base.modalidade_nome) ? 'pregao_eletronico'\n  : base.modalidade_nome && /dispensa/i.test(base.modalidade_nome) ? 'dispensa' : parsed.tipo_disputa;\nreturn [{ json: {\n  perfil_id: base.perfil_id,\n  pncp_id: base.pncp_id,\n  objeto_resumo: parsed.objeto_resumo || base.objeto,\n  tipo_disputa: tipoDisputa,\n  valor_estimado: parsed.valor_estimado != null ? parsed.valor_estimado : base.valor,\n  prazo_proposta: parsed.prazo_proposta || null,\n  prazo_entrega: parsed.prazo_entrega || null,\n  documentos_exigidos: parsed.documentos_exigidos || null,\n  tipo_software: base.tipo_perfil === 'servico_software' ? (parsed.tipo_software || null) : null\n} }];"
      }
    },
    {
      "id": "res-000j",
