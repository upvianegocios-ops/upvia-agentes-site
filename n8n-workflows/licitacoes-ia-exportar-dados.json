      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.objeto_resumo AS objeto, p.valor_ofertado, p.status, p.criado_em\nFROM licitacoes_propostas p\nLEFT JOIN licitacoes_resumos r ON r.id = p.resumo_id\nWHERE p.usuario_id = $1\n  AND ($2::timestamptz IS NULL OR p.criado_em >= $2)\n  AND ($3::timestamptz IS NULL OR p.criado_em <= $3)\nORDER BY p.criado_em DESC;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario_id, $json.data_inicio, $json.data_fim ] }}"
        }
