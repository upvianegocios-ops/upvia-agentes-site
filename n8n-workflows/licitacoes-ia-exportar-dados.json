        200
      ],
      "parameters": {
        "jsCode": "const dados = $('Fim Buscar Dados Export').first().json;\nconst usuario = $input.first().json || {};\nif (!usuario.whatsapp_numero) return [];\nconst texto = 'Nao encontrei dados de \"' + dados.tipo_dado + '\" pra exportar nesse periodo.';\nreturn [{ json: { numero: usuario.whatsapp_numero.replace(/\\D/g, ''), texto } }];"
