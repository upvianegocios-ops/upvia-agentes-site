    {
      "id": "exp-000r",
      "name": "Montar Payload Export WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -160
      ],
      "parameters": {
        "jsCode": "// BUG REAL DE PRODUCAO (testado ao vivo): este N8N usa modo de armazenamento\n// binario \"filesystem\" (confirmado pela presenca de um campo \"id\" no binary),\n// nao \"memory\" -- nesse modo, \"item.binary.data.data\" NAO e o base64 real, e sim\n// uma referencia interna curta (ex: \"filesystem-v2\", 13 chars, exatamente o\n// tamanho visto no bug real). O jeito correto e agnostico ao modo de\n// armazenamento e usar this.helpers.getBinaryDataBuffer(indice, propriedade).\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = buffer.toString('base64');\nconst usuario = $('Buscar Usuario Exportar').first().json || {};\nconst tipo = $('Fim Buscar Dados Export').first().json.tipo_dado;\nconst dataHoje = new Date().toISOString().slice(0, 10);\nreturn [{ json: {\n  numero: (usuario.whatsapp_numero || '').replace(/\\D/g, ''),\n  base64,\n  fileName: 'licitacoes_' + tipo + '_' + dataHoje + '.xlsx'\n} }];"
      }
    },
