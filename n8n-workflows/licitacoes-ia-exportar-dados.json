    {
      "id": "exp-000a",
      "name": "Buscar Licitacoes Export",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        -160
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "VxM0N4ryXNa6wkI2",
          "name": "Postgres account 2"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT objeto_resumo, tipo_disputa, valor_estimado, prazo_proposta, prazo_entrega, documentos_exigidos, resultado, criado_em\nFROM licitacoes_resumos\nWHERE usuario_id = $1\n  AND ($2::timestamptz IS NULL OR criado_em >= $2)\n  AND ($3::timestamptz IS NULL OR criado_em <= $3)\nORDER BY criado_em DESC;",
        "options": {
          "queryReplacement": "={{ [ $json.usuario_id, $json.data_inicio, $json.data_fim ] }}"
        }
      }
    },
    {
      "id": "exp-000b",
      "name": "Marcar Linhas Licitacoes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ],
      "parameters": {
        "jsCode": "const linhas = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nreturn [{ json: { tipo_dado: 'licitacoes', linhas } }];"
      }
    },
