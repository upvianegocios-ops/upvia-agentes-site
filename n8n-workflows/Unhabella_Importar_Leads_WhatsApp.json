    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet quente = 0, morno = 0, frio = 0, inativo = 0;\n\nfor (const item of items) {\n  const temp = item.json.temperatura;\n  if (temp === 'quente') quente++;\n  else if (temp === 'morno') morno++;\n  else if (temp === 'frio') frio++;\n  else if (temp === 'inativo') inativo++;\n}\n\nreturn [{ json: { total: items.length, quente, morno, frio, inativo } }];"
      },
