      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Buscar Mensagens do Contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const mensagensInput = $input.first().json;\nconst mensagens = Array.isArray(mensagensInput)\n  ? mensagensInput\n  : (mensagensInput.messages || mensagensInput.data || []);\n\nconst contactData = $('SplitInBatches').item.json;\nconst whatsapp = contactData.whatsapp || '';\nconst nome = contactData.nome || '';\n\nconst linhas = [];\nfor (const msg of mensagens) {\n  const ts = msg.messageTimestamp || msg.timestamp;\n  const data = ts ? new Date(ts * 1000).toISOString().split('T')[0] : '?';\n  const texto = (msg.message && msg.message.conversation)\n    || (msg.message && msg.message.extendedTextMessage && msg.message.extendedTextMessage.text)\n    || (msg.message && msg.message.imageMessage && msg.message.imageMessage.caption)\n    || '[mídia]';\n  const quem = (msg.key && msg.key.fromMe) ? 'Eu' : 'Contato';\n  linhas.push('[' + data + '] ' + quem + ': ' + texto);\n}\n\nlet contexto = linhas.join('\\n');\nif (contexto.length > 1500) {\n  contexto = contexto.substring(contexto.length - 1500);\n}\n\nreturn [{ json: { whatsapp, nome, contexto: contexto || '(sem mensagens)' } }];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Montar Contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "Você analisa conversas de WhatsApp de uma loja de películas de unha chamada Unhabella. Retorne SOMENTE JSON válido, sem markdown:\n{\n  \"temperatura\": \"quente|morno|frio|inativo\",\n  \"ja_comprou\": true,\n  \"resumo\": \"máximo 2 frases sobre interesse da pessoa\",\n  \"origem\": \"facebook_ads|instagram|indicacao|desconhecido\",\n  \"ultima_interacao\": \"YYYY-MM-DD\"\n}\nCritérios:\n- quente: comprou OU pediu preço/prazo recentemente\n- morno: demonstrou interesse mas não fechou\n- frio: não respondeu ou só visualizou\n- inativo: pediu pra parar ou não trabalha mais com unhas",
              "role": "system"
            },
            {
              "content": "={{ $json.contexto }}",
              "role": "user"
            }
          ]
        },
        "simplifyOutput": true,
        "options": {
          "temperature": 0
        }
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Classificar Lead",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [1540, 300],
      "credentials": {
        "openAiApi": {
          "id": "sjemA3sd4BGEaIHJ",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiData = $input.first().json;\nconst contactData = $('SplitInBatches').item.json;\nconst whatsapp = contactData.whatsapp || '';\nconst nome = contactData.nome || '';\n\nconst rawContent = aiData.text || aiData.content || aiData.message || '{}';\n\nlet parsed;\ntry {\n  const jsonMatch = rawContent.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(jsonMatch ? jsonMatch[0] : rawContent);\n} catch (e) {\n  parsed = {\n    temperatura: 'frio',\n    ja_comprou: false,\n    resumo: 'Erro ao classificar',\n    origem: 'desconhecido',\n    ultima_interacao: new Date().toISOString().split('T')[0]\n  };\n}\n\nconst telefone = whatsapp.replace('@s.whatsapp.net', '');\n\nreturn [{\n  json: {\n    nome,\n    whatsapp,\n    telefone,\n    temperatura: parsed.temperatura || 'frio',\n    ja_comprou: parsed.ja_comprou === true || parsed.ja_comprou === 'true',\n    resumo_conversa: parsed.resumo || '',\n    origem: parsed.origem || 'desconhecido',\n    ultima_interacao: parsed.ultima_interacao || new Date().toISOString().split('T')[0],\n    status: 'ativo'\n  }\n}];"
      },
