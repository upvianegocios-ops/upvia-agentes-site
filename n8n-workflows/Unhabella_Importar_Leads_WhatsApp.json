      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Buscar Todos os Chats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [340, 300]
    },
    {
      "parameters": {
        "jsCode": "const chats = $input.first().json;\nconst chatArray = Array.isArray(chats) ? chats : (chats.data || []);\nconst ADMIN_NUMBER = '5553[SEU_NUMERO]@s.whatsapp.net';\nconst contatos = [];\nconst seen = new Set();\n\nfor (const chat of chatArray) {\n  const remoteJid = chat.remoteJid || chat.id || '';\n  if (remoteJid.includes('@g.us')) continue;\n  if (remoteJid === 'status@broadcast') continue;\n  if (remoteJid === ADMIN_NUMBER) continue;\n  if (!remoteJid.includes('@s.whatsapp.net')) continue;\n  if (seen.has(remoteJid)) continue;\n  seen.add(remoteJid);\n  contatos.push({\n    whatsapp: remoteJid,\n    nome: chat.name || chat.pushName || remoteJid.split('@')[0]\n  });\n}\n\nreturn contatos.map(c => ({ json: c }));"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Filtrar Contatos Válidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, 300]
    },
