      "parameters": {
        "jsCode": "const redisRaw = $json.value || '[]';\nlet fotos = [];\ntry { fotos = JSON.parse(redisRaw); } catch(e) { fotos = []; }\n\nconst base64Data = $('Baixar Foto (Base64)').first().json;\nconst base64 = base64Data.base64 || base64Data.data || '';\nconst msgId = $('Filtrar Mensagem').first().json.messageId;\n\nfotos.push({ msgId, base64, index: fotos.length + 1 });\n\nreturn [{ json: { fotos, totalFotos: fotos.length, fotosJson: JSON.stringify(fotos) } }];"
