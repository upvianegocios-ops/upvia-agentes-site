    {
      "parameters": {
        "jsCode": "const fotosRaw = $json.value || '[]';\nlet fotos = [];\ntry { fotos = JSON.parse(fotosRaw); } catch(e) { fotos = []; }\n\nconst produtos = $('Parsear Descrições').first().json.produtos || [];\nconst remoteJid = $('Parsear Descrições').first().json.remoteJid;\n\nif (fotos.length === 0) {\n  return [{ json: { erro: 'sem_fotos', remoteJid } }];\n}\n\nif (produtos.length !== fotos.length) {\n  return [{ json: { \n    erro: 'quantidade_diferente', \n    remoteJid,\n    totalFotos: fotos.length,\n    totalDescricoes: produtos.length\n  } }];\n}\n\n// Gerar timestamp base para códigos\nconst agora = new Date();\nconst prefixo = 'PEL';\n\nconst itens = fotos.map((foto, idx) => {\n  const produto = produtos[idx];\n  const codigo = `${prefixo}-${String(agora.getTime()).slice(-4)}${String(idx + 1).padStart(2, '0')}`;\n  return {\n    codigo,\n    nome: produto.nome,\n    quantidade: produto.qtd,\n    preco: produto.preco,\n    base64: foto.base64,\n    index: idx + 1\n  };\n});\n\nreturn [{ json: { itens, totalItens: itens.length, remoteJid, erro: null } }];"
      },
