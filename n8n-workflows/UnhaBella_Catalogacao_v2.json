    {
      "parameters": {
        "jsCode": "const texto = $json.textoMensagem || '';\nconst remoteJid = $json.remoteJid;\n\nif (texto.trim().toUpperCase() === 'CANCELAR') {\n  return [{ json: { acao: 'cancelar', remoteJid, linhas: [] } }];\n}\n\nconst linhas = texto.split('\\n')\n  .map(l => l.trim())\n  .filter(l => l.length > 0 && l.includes('|'));\n\nif (linhas.length === 0) {\n  return [{ json: { acao: 'ignorar', remoteJid, linhas: [] } }];\n}\n\nconst produtos = linhas.map((linha, idx) => {\n  const partes = linha.split('|').map(p => p.trim());\n  const nome = partes[0] || 'Película ' + (idx + 1);\n  const qtd = partes[1] || '';\n  const preco = partes[2] || '';\n  const precoPromo = partes[3] || '';\n  \n  const precoNum = parseFloat(preco.replace('R$','').replace(',','.').trim()) || 0;\n  const precoPromoNum = parseFloat(precoPromo.replace('R$','').replace(',','.').trim()) || 0;\n  const qtdNum = parseInt(qtd.replace(/[^0-9]/g, '')) || 0;\n  \n  const temPromocao = precoPromoNum > 0 && precoPromoNum < precoNum;\n  \n  return { \n    index: idx + 1, \n    nome, \n    qtd: qtdNum, \n    preco: precoNum, \n    preco_promocional: precoPromoNum,\n    em_promocao: temPromocao ? 'Sim' : 'Não'\n  };\n});\n\nreturn [{ json: { acao: 'processar', remoteJid, produtos, totalProdutos: produtos.length } }];"
      },
      "id": "419af91e-bee8-4cd6-8367-1fdc7f92bd04",
      "name": "Parsear Descrições",
