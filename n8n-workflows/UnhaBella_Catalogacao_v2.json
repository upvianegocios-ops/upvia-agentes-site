    {
      "parameters": {
        "jsCode": "// Avisa erro de quantidade diferente\nconst dados = $json;\nconst remoteJid = dados.remoteJid;\nlet msg = '';\n\nif (dados.erro === 'sem_fotos') {\n  msg = '⚠️ Não encontrei fotos salvas. Manda as fotos primeiro, depois as descrições.';\n} else if (dados.erro === 'quantidade_diferente') {\n  msg = `⚠️ Você mandou *${dados.totalFotos} fotos* mas *${dados.totalDescricoes} descrições*. Precisa ser igual! Manda as descrições de novo com ${dados.totalFotos} linhas (uma por foto).`;\n}\n\nreturn [{ json: { mensagem: msg, remoteJid } }];"
      },
      "id": "9b80c851-1dfa-4345-a0e5-cf9d4df386a6",
      "name": "Montar Mensagem de Erro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1104, 304]
    },
    {
      "parameters": {
        "jsCode": "// Separar cada item do lote em itens individuais para processar\nconst itens = $json.itens || [];\nreturn itens.map(item => ({ json: item }));"
      },
      "id": "924d3cc2-388d-42c0-ba8b-f035f82eb527",
      "name": "Separar Itens do Lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1104, 128]
    },
    {
      "parameters": {
        "jsCode": "const { createCanvas, loadImage } = require('canvas');\n\nconst item = $input.first().json;\nconst base64 = item.base64 || '';\nconst codigo = item.codigo || 'SEM-CODIGO';\n\nif (!base64) {\n  return [{ json: { ...item } }];\n}\n\nconst imageBuffer = Buffer.from(base64, 'base64');\nconst img = await loadImage(imageBuffer);\n\nconst MAX = 800;\nlet w = img.width;\nlet h = img.height;\nif (w > MAX || h > MAX) {\n  if (w > h) {\n    h = Math.round(h * MAX / w);\n    w = MAX;\n  } else {\n    w = Math.round(w * MAX / h);\n    h = MAX;\n  }\n}\n\nconst canvas = createCanvas(w, h);\nconst ctx = canvas.getContext('2d');\nctx.drawImage(img, 0, 0, w, h);\n\nconst fontSize = 20;\nconst padding = 8;\nctx.font = `bold ${fontSize}px sans-serif`;\nconst textWidth = ctx.measureText(codigo).width;\nconst bgX = w - textWidth - padding * 2 - 10;\nconst bgY = h - fontSize - padding * 2 - 10;\nconst bgW = textWidth + padding * 2;\nconst bgH = fontSize + padding * 2;\n\nctx.fillStyle = 'rgba(0, 0, 0, 0.6)';\nctx.fillRect(bgX, bgY, bgW, bgH);\n\nctx.fillStyle = '#ffffff';\nctx.fillText(codigo, bgX + padding, bgY + fontSize + Math.floor(padding / 2));\n\nconst processedBase64 = canvas.toDataURL('image/jpeg', 0.85).split(',')[1];\n\nreturn [{ json: { ...item, base64: processedBase64 } }];"
      },
