    {
      "parameters": {
        "jsCode": "const dados = $json;\nconst remoteJid = dados.remoteJid;\nlet mensagem = '';\n\nif (dados.erro === 'sem_fotos') {\n  mensagem = '⚠️ Não encontrei fotos salvas. Manda as fotos primeiro, depois as descrições.';\n} else if (dados.erro === 'quantidade_diferente') {\n  mensagem = `⚠️ Você mandou *${dados.totalFotos} fotos* mas *${dados.totalDescricoes} descrições*. Precisa ser igual! Manda as descrições de novo com ${dados.totalFotos} linhas (uma por foto).`;\n}\n\nreturn [{ json: { mensagem, remoteJid } }];"
      },
