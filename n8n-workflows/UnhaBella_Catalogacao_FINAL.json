    {
      "parameters": {
        "jsCode": "// Lê total de fotos acumuladas (Redis retorna em propertyName ou value)\nconst raw = $json.propertyName || $json.value || '[]';\nlet fotos = [];\ntry { fotos = JSON.parse(raw); } catch(e) { fotos = []; }\n\nconst total = fotos.length;\nconst remoteJid = $('Parsear Descrições').first().json.remoteJid;\n\nif (total === 0) {\n  const mensagem = '⚠️ Não encontrei fotos salvas. Manda as fotos primeiro!';\n  return [{ json: { mensagem, remoteJid, totalFotos: 0 } }];\n}\n\nconst plural = total !== 1 ? 'fotos' : 'foto';\nconst mensagem = `✅ Recebi ${total} ${plural}! Agora mande as descrições:\\n\\nNome do produto | Qtd | Preço | Preço promocional\\n\\nUma linha por foto, na mesma ordem.\\nSe errar alguma linha, mande tudo de novo.`;\n\nreturn [{ json: { mensagem, remoteJid, totalFotos: total } }];"
      },
