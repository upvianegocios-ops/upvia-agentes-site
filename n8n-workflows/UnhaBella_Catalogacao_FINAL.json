    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst event = body.event || '';\nconst data = body.data || {};\nconst msg = data.message || {};\nconst key = data.key || {};\n\nif (key.remoteJid && key.remoteJid.includes('@g.us')) return [];\nif (key.fromMe) return [];\nif (event !== 'messages.upsert') return [];\n\nconst remoteJid = key.remoteJid || '';\nconst tipoMensagem = msg.imageMessage ? 'foto'\n  : msg.conversation || msg.extendedTextMessage ? 'texto'\n  : 'outro';\n\nconst textoMensagem = msg.conversation\n  || (msg.extendedTextMessage && msg.extendedTextMessage.text)\n  || (msg.imageMessage && msg.imageMessage.caption)\n  || '';\n\nconst messageId = key.id || '';\n\nreturn [{ json: { remoteJid, tipoMensagem, textoMensagem, messageId, mensagemCompleta: msg } }];"
      },
