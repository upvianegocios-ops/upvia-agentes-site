    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst base64 = item.base64 || '';\nconst codigo = item.codigo || 'SEM-CODIGO';\nconst nomeSeguro = (item.nome || 'pelicula').replace(/[^a-zA-Z0-9_\\-\\u00C0-\\u017E]/g, '_');\nconst nomeArquivo = `${codigo}_${nomeSeguro}.jpg`;\nconst buffer = Buffer.from(base64, 'base64');\n\nreturn [{\n  json: { ...item, nomeArquivo },\n  binary: {\n    data: {\n      data: base64,\n      mimeType: 'image/jpeg',\n      fileName: nomeArquivo,\n      fileSize: buffer.length\n    }\n  }\n}];"
      },
