    {
      "parameters": {
        "jsCode": "// Lê o array de fotos já acumuladas (Redis pode retornar em propertyName ou value)\nconst redisRaw = $json.propertyName || $json.value || '[]';\nlet fotos = [];\ntry { fotos = JSON.parse(redisRaw); } catch(e) { fotos = []; }\n\nconst base64Data = $('Baixar Foto (Base64)').first().json;\nconst base64 = base64Data.base64\n  || base64Data.data\n  || base64Data.image\n  || base64Data.mediaData\n  || base64Data.media\n  || '';\n\nif (!base64) {\n  const campos = Object.keys(base64Data).join(', ');\n  throw new Error('Base64 não encontrado. Campos disponíveis: ' + campos);\n}\n\nconst msgId = $('Filtrar Mensagem').first().json.messageId;\nfotos.push({ msgId, base64, index: fotos.length + 1 });\n\nreturn [{ json: { fotos, totalFotos: fotos.length, fotosJson: JSON.stringify(fotos) } }];"
      },
