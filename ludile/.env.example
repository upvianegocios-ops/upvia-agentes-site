# Ludilê — variáveis de ambiente
# Nunca commitar .env real. Nunca reaproveitar credenciais do UpVia Agentes.

# Supabase (self-hosted na VPS, isolado do projeto do UpVia)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nome do produto configurável (seção 3 — nunca hardcoded)
NEXT_PUBLIC_APP_NAME=Ludilê

# TTS externo opcional (fallback é sempre a Web SpeechSynthesis API do navegador)
TTS_PROVIDER=browser
TTS_API_KEY=

# Ambiente
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
